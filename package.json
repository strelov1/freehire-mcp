{
  "name": "freehire-mcp",
  "version": "1.0.6",
  "mcpName": "me.freehire/freehire",
  "description": "Search 4.9M+ unique open jobs from 437 sources. Find your next role, compare salaries and track your job search with AI.",
  "type": "module",
  "bin": {
    "freehire-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "build:mcpb": "node scripts/build-mcpb.mjs",
    "build:plugins": "python3 scripts/build-plugins.py",
    "test:plugins": "python3 -m unittest discover -s scripts -p 'test_*.py'",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "modelcontextprotocol",
    "freehire",
    "jobs",
    "ats"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/strelov1/freehire-mcp.git"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.5.0",
    "vitest": "^4.1.10"
  }
}
